{
  "name": "quizcast-studio",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok LIVE sohbetinden skor tutan yerel yarışma stüdyosu ve 9:16 OBS yayın ekranı.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write client server shared data scripts tests *.ts *.json *.md",
    "format:check": "prettier --check client server shared data scripts tests *.ts *.json *.md",
    "license:keygen": "node --import tsx scripts/license-cli.ts keygen",
    "license:issue": "node --import tsx scripts/license-cli.ts issue"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
