# Local-only by design. Do not expose this server directly to the internet.
PORT=4317
DATA_DIR=./data-local

# Optional live adapter; keep your API key on the server, never in VITE_* variables.
EULER_API_KEY=

# Customer installations: configure the PUBLIC verification key, not the private key.
LICENSE_PUBLIC_KEY_FILE=

# Owner-only development override; do not distribute enabled to customers.
ALLOW_UNLICENSED_LIVE=false

# Simulated viewers while the studio is open. Set false for a quiet panel.
DEMO_AUTO=true
